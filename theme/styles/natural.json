{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Natural",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#fdfaf5", "name": "Base" },
        { "slug": "contrast", "color": "#3b3229", "name": "Contrast" },
        { "slug": "primary", "color": "#7a8c6a", "name": "Primary" },
        { "slug": "secondary", "color": "#c98a5e", "name": "Secondary" },
        { "slug": "surface", "color": "#f5efe6", "name": "Surface" },
        { "slug": "border", "color": "#d9c7ab", "name": "Border" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif"
        }
      ]
    }
  },
  "styles": {
    "elements": {
      "button": {
        "border": { "radius": "999px" }
      }
    }
  }
}
