					<item>
		<title><![CDATA[建設業許可を初回申請で取得]]></title>
		<link>http://127.0.0.1:8895/cases/%e5%bb%ba%e8%a8%ad%e6%a5%ad%e8%a8%b1%e5%8f%af%e3%82%92%e5%88%9d%e5%9b%9e%e7%94%b3%e8%ab%8b%e3%81%a7%e5%8f%96%e5%be%97/</link>
