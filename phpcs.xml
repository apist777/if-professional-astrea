<?xml version="1.0"?>
<ruleset name="ASTREA">
    <description>Coding standard for ASTREA Theme (theme/) and ASTREA Core (core/).</description>

    <file>./theme</file>
    <file>./core</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress">
        <!-- File naming (theme/style.css, core/astrea-core.php) intentionally follows
             WordPress theme/plugin main-file conventions, not the stricter class-based
             file naming rule. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="astrea"/>
                <element value="astrea-core"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="astrea"/>
                <element value="Astrea"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="7.0"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.3-"/>
</ruleset>
