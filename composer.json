{
    "name": "project-if/astrea",
    "description": "If Professional ASTREA — ASTREA Theme / ASTREA Core の開発用ツールチェーン（Coding Standards, PHP Compatibility）。製品自体はPHP 8.3以上を対象とする（Decision 020）。",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs"
    }
}
